---
import Base from './Base.astro';
const active = Astro.url.pathname.includes('_publication-template-docs') ? 'docs' : 'roadmap';
---
<Base title="__ROADMAP_TITLE__" description="__ROADMAP_DESCRIPTION__" active={active} canonicalPath="/__ROADMAP_PATH__" publicationTemplate>
  <div id="published-root"><!--ROADMAP_CONTENT--></div>
  <script id="published-seed" type="application/json" is:inline set:html="__ROADMAP_SEED__" />
  <script type="module" src="__ROADMAP_CLIENT__" is:inline></script>
</Base>
