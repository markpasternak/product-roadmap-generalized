---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import MarkdownContent from '../../../components/markdown/MarkdownContent.astro';
import Mermaid from '../../../components/markdown/Mermaid.vue';
import Breadcrumb from '../../../components/ui/Breadcrumb.vue';
import { getVisibleDocCollection } from '../../../lib/docs';
import { parseLinks } from '../../../lib/items';
import { toneSurface, toneText, type Tone } from '../../../lib/display';
import { IS_PUBLIC } from '../../../lib/audience';
import { formatDateOnly, isoDateOnly } from '../../../lib/dates';
import {
  DOC_COLLECTIONS,
  DOC_TYPE_LABEL,
  DOC_TYPE_ROUTE,
  docBasename,
} from '../../../lib/slugs';

export async function getStaticPaths() {
  const base = import.meta.env.BASE_URL;
  const prefix = base.replace(/\/$/, '');
  const items = (await getCollection('items')).filter(
    (it) => !IS_PUBLIC || it.data.visibility === 'Public',
  );

  // reverse index: doc route → items that reference it
  const back: Record<string, { id: string; title: string; href: string }[]> = {};
  for (const it of items) {
    for (const ln of parseLinks(it.body ?? '', base)) {
      if (ln.kind === 'doc')
        (back[ln.href] ??= []).push({
          id: it.data.id,
          title: it.data.title,
          href: `${prefix}/item/${it.data.id}`,
        });
    }
  }

  const paths = [];
  for (const coll of DOC_COLLECTIONS) {
    const docs = await getVisibleDocCollection(coll);
    for (const entry of docs) {
      const slug = docBasename(entry.id);
      const type = DOC_TYPE_ROUTE[coll];
      const selfHref = `${prefix}/docs/${type}/${slug}`;
      const backlinks = [...(back[selfHref] ?? [])];
      const linkedItem = items.find((item) => item.data.id === entry.data.roadmap_item);
      if (linkedItem && !backlinks.some((link) => link.id === linkedItem.data.id)) {
        backlinks.push({ id: linkedItem.data.id, title: linkedItem.data.title, href: `${prefix}/item/${linkedItem.data.id}` });
      }
      paths.push({ params: { type, slug }, props: { entry, coll, backlinks } });
    }
  }
  return paths;
}

const { entry, coll, backlinks } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const title = entry.data.title ?? docBasename(entry.id);
const typeTone = { prds: 'orange', techDesign: 'blue', research: 'green' }[coll] as Tone;
---

<Base title={`${title} · Source documents`} active="docs">
  <main class="support-page page-reveal mx-auto max-w-3xl px-6 py-10">
      <Breadcrumb
        items={[
          { label: 'Roadmap', href: base },
          { label: 'Source documents', href: `${base}docs` },
          { label: title },
        ]}
      />

      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span
          class="text-single-sm-medium rounded-md px-2 py-0.5 font-semibold tracking-wide uppercase"
          style={`background: ${toneSurface[typeTone]}; color: ${toneText[typeTone]}`}
        >
          {DOC_TYPE_LABEL[coll]}
        </span>
        {
          entry.data.status && (
            <span class="text-single-sm-medium text-text-subtle-default bg-surface-subtle-default rounded-full px-2.5 py-0.5">
              {entry.data.status}
            </span>
          )
        }
      </div>

      <h1 class="roadmap-display text-text-primary-default mt-5 text-[2.25rem] sm:text-[3rem] text-balance">{title}</h1>
      {entry.data.updated && <p class="text-single-sm-medium text-text-subtle-default mt-4">Updated <time datetime={isoDateOnly(entry.data.updated)}>{formatDateOnly(entry.data.updated)}</time></p>}

      {
        backlinks.length > 0 && (
          <details class="document-disclosure mt-5">
            <summary>Related roadmap items <span class="text-text-subtle-default">· {backlinks.length}</span></summary>
            <ul class="grid gap-1 pb-3">
              {backlinks.map((b) => (
                <li><a href={b.href} class="inline-flex min-h-10 items-center py-1 text-sm text-text-link-default underline-offset-4 hover:underline">{b.title} ({b.id})</a></li>
              ))}
            </ul>
          </details>
        )
      }

      <article class="mt-5"><MarkdownContent entry={entry} showContents /></article>
      <Mermaid client:load />
    </main>
</Base>
