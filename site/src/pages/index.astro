---
import Base from '../layouts/Base.astro';
import Board from '../components/board/Board.vue';
import { buildBoardItems } from '../lib/board';
import { productListSentence } from '../lib/display';

const base = import.meta.env.BASE_URL;
const items = await buildBoardItems(base);
---

<Base
  title="Product Roadmap"
  active="roadmap"
  description={`The Now, Next and Later roadmap across ${productListSentence()}, ordered by confidence rather than dates.`}
>
  <main class="mx-auto max-w-[1600px] px-4 py-4 sm:px-6 sm:py-5">
    <Board client:load items={items} base={base} />
  </main>
</Base>
