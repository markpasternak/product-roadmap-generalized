---
import Base from '../layouts/Base.astro';
import { IS_PUBLIC } from '../lib/audience';

const base = import.meta.env.BASE_URL;
---

<Base title="Not found · Roadmap" description="This page doesn't exist on this roadmap.">
  <main class="page-reveal mx-auto max-w-xl px-4 py-20 text-center sm:px-6">
    <p class="text-single-sm-medium text-text-subtle-default font-semibold tracking-wide uppercase">404</p>
    <h1 class="font-display text-text-primary-default mt-3 text-[2rem] sm:text-[2.4rem]">Nothing here</h1>
    <p class="text-body-md text-text-subtle-default mt-3 text-balance">
      {
        IS_PUBLIC
          ? 'This page doesn’t exist, or it’s an internal item that isn’t on the public roadmap.'
          : 'This page doesn’t exist. The item may have been renamed or removed.'
      }
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a
        href={base}
        class="bg-foreground text-text-primary-inverted-default text-single-base-medium rounded-lg px-4 py-2.5"
      >
        Open the roadmap
      </a>
      <a
        href={`${base.replace(/\/$/, '')}/docs`}
        class="border-border-subtle-default bg-card text-single-base-medium text-text-primary-default hover:bg-surface-primary-hover rounded-lg border px-4 py-2.5 transition-colors"
      >
        Source documents
      </a>
    </div>
  </main>
</Base>
