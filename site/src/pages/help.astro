---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/ui/Breadcrumb.vue';
import { HORIZONS, STAGES, PRODUCTS, VISIBILITIES } from '../lib/schema';
import { horizonDot, horizonDescription, productColor, productShort, levelTone, toneText } from '../lib/display';

const base = import.meta.env.BASE_URL;

const STAGE_DESCRIPTION: Record<(typeof STAGES)[number], string> = {
  Discovery: 'Exploring the problem. Nothing is committed yet.',
  Validation: 'Checking with users and data that the problem is real, and our answer with it.',
  Shaping: 'Defining scope and approach so it could be picked up.',
  Committed: 'Agreed and queued. It will be built.',
  Building: 'In active development.',
  Pilot: 'Live with a limited set of users before general availability.',
  Shipped: 'Generally available.',
  Parked: 'On hold on purpose. Kept for the record.',
};

const PRODUCT_DESCRIPTION: Record<(typeof PRODUCTS)[number], string> = {
  'Spotify for Artists': 'Its own folder and ID prefix — items live under content/items/spotify-for-artists/ as ARTISTS-NNN.',
  'Ads Platform': 'Its own folder and ID prefix — items live under content/items/ads-platform/ as ADS-NNN.',
  'Core Platform & Data': 'Its own folder and ID prefix — items live under content/items/core-platform-data/ as PLATFORM-NNN.',
  'Music App': 'Its own folder and ID prefix — items live under content/items/music-app/ as MUSIC-NNN.',
  'Podcasts & Audiobooks': 'Its own folder and ID prefix — items live under content/items/podcasts-audiobooks/ as TALK-NNN.',
};

const TOC = [
  { href: '#mental-model', label: 'The mental model' },
  { href: '#horizons', label: 'Horizons' },
  { href: '#stages', label: 'Stages' },
  { href: '#products', label: 'Products' },
  { href: '#other-fields', label: 'Owner, impact, effort, visibility, tags, order' },
  { href: '#reading-the-board', label: 'Reading the board' },
  { href: '#editing', label: 'Editing in the app' },
  { href: '#latest-changes', label: 'Latest changes' },
  { href: '#new-with-ai', label: 'New with AI' },
  { href: '#rewrite-with-ai', label: 'Rewrite with AI' },
  { href: '#presence', label: 'Live presence' },
  { href: '#how-it-connects', label: 'How it connects to GitHub' },
  { href: '#shares', label: 'Sharing a view' },
  { href: '#why-no-dates', label: 'Why no dates?' },
];
---

<Base
  title="How the roadmap works · Roadmap"
  active="help"
  description="A practical guide to reading, editing, and sharing the Product Roadmap product roadmap."
>
  <main class="support-page page-reveal mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <Breadcrumb items={[{ label: 'Roadmap', href: base }, { label: 'Help' }]} />
    <section class="roadmap-masthead mt-6 rounded-[20px] px-5 py-5 sm:px-6 sm:py-6 lg:px-7">
      <p class="roadmap-label">Roadmap guide</p>
      <h1 class="roadmap-display roadmap-title mt-2 text-[2rem] sm:text-[2.55rem]">How the roadmap <em>works.</em></h1>
      <p class="roadmap-muted text-body-lg mt-3 max-w-2xl">
        This is a <b class="roadmap-title">Now / Next / Later</b> roadmap. Horizons communicate confidence and
        sequence without pretending every idea has a reliable date.
      </p>
      <p class="roadmap-muted text-body-md mt-2 max-w-2xl">
        Use this guide to read the board, understand its fields, edit the source safely, and publish a filtered snapshot.
      </p>
    </section>

    <div class="mt-5 grid items-start gap-5 lg:grid-cols-[230px_minmax(0,1fr)]">
      <nav class="roadmap-glass rounded-2xl p-3 lg:sticky lg:top-17" aria-label="On this page">
        <details class="lg:hidden">
          <summary class="text-single-sm-medium text-text-primary-default flex cursor-pointer items-center justify-between gap-3 px-2 py-1 font-semibold">
            <span class="roadmap-label">On this page</span>
            <span class="text-text-subtle-default font-normal">{TOC.length} sections</span>
          </summary>
          <ul class="mt-2 grid gap-0.5 sm:grid-cols-2">
            {
              TOC.map((t, index) => (
                <li>
                  <a
                    href={t.href}
                    class="roadmap-action text-single-sm-medium text-text-subtle-default hover:bg-surface-primary-hover hover:text-text-primary-default flex items-start gap-2 rounded-lg px-2 py-1.5"
                  >
                    <span class="mt-0.5 w-5 shrink-0 text-right text-[0.68rem] tabular-nums opacity-55">{String(index + 1).padStart(2, '0')}</span>
                    <span>{t.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </details>

        <div class="hidden lg:block">
          <p class="roadmap-label px-2 pt-1">On this page</p>
          <ul class="mt-2 grid gap-0.5">
            {
              TOC.map((t, index) => (
                <li>
                  <a
                    href={t.href}
                    class="roadmap-action text-single-sm-medium text-text-subtle-default hover:bg-surface-primary-hover hover:text-text-primary-default flex items-start gap-2 rounded-lg px-2 py-1.5"
                  >
                    <span class="mt-0.5 w-5 shrink-0 text-right text-[0.68rem] tabular-nums opacity-55">{String(index + 1).padStart(2, '0')}</span>
                    <span>{t.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>

      <article class="help-article roadmap-panel rounded-[24px] px-5 pb-8 sm:px-7 lg:px-9">

    <section id="mental-model" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">The mental model</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        <b class="text-text-primary-default">The markdown files are the source of truth. This site is a live,
        editable view of them.</b> Every item on the board is one file under <code class="text-single-sm-medium bg-surface-subtle-default rounded px-1.5 py-0.5">content/items/&lt;product&gt;/</code>
        in the roadmap's GitHub repo — nothing lives in a separate database. If you can see it on the board, a
        file says so; if you change it here, that change becomes a commit to that same file.
      </p>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        Everything below follows from that one fact — including the whole editing model in
        <a href="#editing" class="text-text-primary-default underline decoration-border-subtle-default underline-offset-4">Editing in the app</a>.
      </p>
    </section>

    <section id="horizons" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">Horizons: how sure we are</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        The lanes on the board. As an item moves toward <b class="text-text-primary-default">Now</b>, our
        confidence grows and the detail fills in. Further out, it stays a broad direction.
      </p>
      <div class="mt-5 flex flex-col gap-2">
        {
          HORIZONS.map((h) => (
            <div class="border-border-subtle-default bg-card flex items-baseline gap-3 rounded-lg border px-4 py-3">
              <span class="flex w-28 shrink-0 items-center gap-2">
                <span class="size-2.5 rounded-full" style={`background:${horizonDot[h]}`} />
                <b class="text-single-base-medium text-text-primary-default">{h}</b>
              </span>
              <span class="text-single-base-medium text-text-subtle-default">{horizonDescription[h]}</span>
            </div>
          ))
        }
      </div>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        The board opens focused on <b class="text-text-primary-default">Now, Next and Later</b> — the stat tiles
        above the lanes double as toggles, so <b class="text-text-primary-default">Candidates</b> (raw intake,
        not committed to the roadmap yet) and <b class="text-text-primary-default">Completed</b> (already
        shipped) stay out of the way until you click them on.
      </p>
    </section>

    <section id="stages" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">Stages: how real it is</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        Independent from the horizon: an item can be <i>Now</i> and still <i>Shaping</i>. The stage tells you how far the work itself has come.
      </p>
      <div class="mt-5 flex flex-col gap-2">
        {
          STAGES.map((s) => (
            <div class="border-border-subtle-default bg-card flex items-baseline gap-3 rounded-lg border px-4 py-3">
              <b class="text-single-base-medium text-text-primary-default w-28 shrink-0">{s}</b>
              <span class="text-single-base-medium text-text-subtle-default">{STAGE_DESCRIPTION[s]}</span>
            </div>
          ))
        }
      </div>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        Rule of thumb: <b class="text-text-primary-default">horizon</b> answers "when, and how confident are we?";
        <b class="text-text-primary-default">stage</b> answers "how cooked is the work itself?"
      </p>
    </section>

    <section id="products" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">Products</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        Every item belongs to exactly one product track. The product decides the item's folder and ID
        prefix, and it's the other way you can slice the board: group by product instead of by horizon to see
        each product's own Now/Next/Later, side by side.
      </p>
      <div class="mt-5 flex flex-col gap-2">
        {
          PRODUCTS.map((p) => (
            <div class="border-border-subtle-default bg-card flex items-baseline gap-3 rounded-lg border px-4 py-3">
              <span class="flex w-40 shrink-0 items-center gap-2">
                <span
                  class="text-single-sm-medium grid size-6 shrink-0 place-items-center rounded font-semibold text-white"
                  style={`background:${productColor[p]}`}
                >
                  {productShort[p]}
                </span>
                <b class="text-single-base-medium text-text-primary-default">{p}</b>
              </span>
              <span class="text-single-base-medium text-text-subtle-default">{PRODUCT_DESCRIPTION[p]}</span>
            </div>
          ))
        }
      </div>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        <b class="text-text-primary-default">Grouping by horizon</b> (the default) answers "what's happening
        across everything, right now?" <b class="text-text-primary-default">Grouping by product</b> answers "what's
        the plan for just this product?" — and it's also what makes drag-to-reorder priority meaningful (see
        <a href="#reading-the-board" class="text-text-primary-default underline decoration-border-subtle-default underline-offset-4">Reading the board</a>).
      </p>
    </section>

    <section id="other-fields" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">Owner, impact, effort, visibility, tags, order</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        The rest of what a card carries — some required, some there only when it earns its place.
      </p>
      <dl class="mt-5 flex flex-col gap-4">
        <div>
          <dt class="text-single-base-medium text-text-primary-default font-semibold">Owner</dt>
          <dd class="text-body-md text-text-subtle-default mt-1 max-w-xl">
            The person accountable for the item. Shown by name on internal cards and in the detail drawer.
            Hidden in presentation mode, public builds, and shares (see <a href="#shares" class="text-text-primary-default underline decoration-border-subtle-default underline-offset-4">Sharing a view</a>).
          </dd>
        </div>
        <div>
          <dt class="text-single-base-medium text-text-primary-default font-semibold">Impact &amp; effort</dt>
          <dd class="text-body-md text-text-subtle-default mt-1 max-w-xl">
            Rough sizing, not precision, each one of <b style={`color:${toneText[levelTone.Low]}`}>Low</b>,
            <b style={`color:${toneText[levelTone.Medium]}`}> Medium</b> or <b style={`color:${toneText[levelTone.High]}`}> High</b>.
            <b class="text-text-primary-default"> Impact</b> is the value we expect it to create;
            <b class="text-text-primary-default"> effort</b> is how much work it takes. High-impact, low-effort
            items tend to move up. Both are optional — an item without either just shows
            <span class="text-single-sm-medium bg-surface-subtle-default text-text-subtle-default rounded px-1.5 py-0.5">Not scored</span>,
            which is a perfectly normal state, not a gap to fill in.
          </dd>
        </div>
        <div>
          <dt class="text-single-base-medium text-text-primary-default font-semibold">Visibility</dt>
          <dd class="text-body-md text-text-subtle-default mt-1 max-w-xl">
            {VISIBILITIES.join(' or ')}, defaulting to Internal. Visibility decides whether an item appears on a
            <b class="text-text-primary-default">public build of the roadmap</b>. A share is different: it starts
            from the board’s current filtered view and its review list, so an Internal item can be included if the
            author selects it. Share payloads still omit owner names and editing links. Review the item list before
            publishing anything outside the team.
          </dd>
        </div>
        <div>
          <dt class="text-single-base-medium text-text-primary-default font-semibold">Tags &amp; themes</dt>
          <dd class="text-body-md text-text-subtle-default mt-1 max-w-xl">
            Free-form labels for filtering — a comma-separated list on the item. A tag written as
            <code class="text-single-sm-medium bg-surface-subtle-default rounded px-1.5 py-0.5">theme:name</code>
            is a cross-cutting theme: it groups items across products and horizons and gets its own page (see
            "Themes" in the nav) instead of just being a filter chip.
          </dd>
        </div>
        <div>
          <dt class="text-single-base-medium text-text-primary-default font-semibold">Order (priority)</dt>
          <dd class="text-body-md text-text-subtle-default mt-1 max-w-xl">
            Where an item sits within its lane, relative to its neighbors — set by dragging (see
            <a href="#editing" class="text-text-primary-default underline decoration-border-subtle-default underline-offset-4">Editing in the app</a>),
            not by typing a number. It's what "Sort: Priority" reflects, and it's scoped to one product's one
            horizon at a time — reordering never reaches across a product or a lane boundary.
          </dd>
        </div>
      </dl>
    </section>

    <section id="reading-the-board" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">Reading the board</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        A card shows the shorthand: product mark, title, short description, stage, and
        the owner on internal views. Sizing, tags, and resources stay in the <b class="text-text-primary-default">detail drawer</b>. Click a card to read the
        full write-up (One-liner, Why it matters, Target outcome, What ships, and whatever optional sections the
        item has), the owner, and — when you're signed in and not viewing a public build — an
        <b class="text-text-primary-default">"Edit on GitHub"</b> link that jumps straight to that item's markdown
        file in GitHub's own web editor.
      </p>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        Use the product selector to choose a product. <b class="text-text-primary-default">Filters</b> opens a side panel for horizons, activity dates, owner and visibility (internal views),
        stage, impact, effort, and tags. Item visibility is separate from access to a shared link.
        <b class="text-text-primary-default">View</b> groups the lanes by horizon or product and sets the sort order:
        Priority (the manual drag order), Highest impact, Lowest effort, Recently updated, or Title (A–Z).
        Use <b class="text-text-primary-default">search</b> to find items, or press <kbd class="text-single-sm-medium bg-surface-subtle-default rounded px-1.5 py-0.5">/</kbd> to jump into it.
      </p>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        <b class="text-text-primary-default">More</b> contains presentation and full-screen actions. Starting a presentation hides
        the board controls; copying its link leaves your current view intact. The link opens the live board with the default horizons and uses its existing access rules.
        <b class="text-text-primary-default">Share</b> creates a separate snapshot, with its own access settings.
        Use <b class="text-text-primary-default">Account</b> in the top navigation for editing sign-in and light or dark appearance.
      </p>
      <div class="border-border-subtle-default bg-card mt-5 flex items-center justify-between gap-3 rounded-lg border px-4 py-3">
        <span class="text-single-base-medium text-text-primary-default font-semibold">Keyboard shortcuts</span>
        <kbd class="text-single-sm-medium bg-surface-subtle-default rounded px-1.5 py-0.5 font-mono">?</kbd>
      </div>
    </section>

    <section id="editing" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">Editing in the app</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        This board doubles as the editor. Anyone with <b class="text-text-primary-default">write access to the
        roadmap's GitHub repo</b> can sign in and edit it directly — no separate account, no ticket.
      </p>

      <h3 class="text-single-base-medium text-text-primary-default mt-6 font-semibold">1. Sign in, then flip into edit mode</h3>
      <p class="text-body-md text-text-subtle-default mt-1.5 max-w-xl">
        Open <b class="text-text-primary-default">Account → Sign in to edit</b> and sign in with GitHub.
        If you have write access, an <b class="text-text-primary-default">Edit</b> button appears on the board.
        In edit mode, cards show drag handles and an inline "+ Add item" control appears in
        every lane, and clicking a card opens the full-screen editor instead of the read-only drawer.
        With a drag handle focused, left and right arrows move between visible horizons; up and down change priority when priority sorting is available.
      </p>

      <h3 class="text-single-base-medium text-text-primary-default mt-6 font-semibold">2. Your draft saves automatically</h3>
      <p class="text-body-md text-text-subtle-default mt-1.5 max-w-xl">
        Your draft saves to this device as you type, then to your account. The save bar shows how many changes are unpublished and whether your private draft is saved. A clean workspace has no save bar. Git changes only when you publish. Your draft covers:
      </p>
      <ul class="text-body-md text-text-subtle-default mt-2 max-w-xl list-disc space-y-1.5 pl-5">
        <li>Editing any field — title, product (new items only), horizon, stage, owner, impact, effort, visibility, tags.</li>
        <li>
          Editing the write-up, in either mode: <b class="text-text-primary-default">structured</b> mode pins the
          three sections every item has (One-liner, Why it matters, What ships) plus a reorderable list of optional
          sections (Target outcome, Who it's for, Open questions, Links, and more), or switch to whole-body
          <b class="text-text-primary-default">markdown</b> mode with a formatting toolbar (bold, italic, lists,
          link, code, quote) for free-form editing. Both modes edit the same underlying text — toggling between
          them re-parses it, nothing is lost.
        </li>
        <li><b class="text-text-primary-default">Dragging a card between lanes</b> changes its horizon (when the board is grouped by horizon).</li>
        <li><b class="text-text-primary-default">Dragging a card within a lane</b> sets its priority order — only enabled while filtered to one product with sort set to Priority and no other filters muddying what "priority" means.</li>
        <li><b class="text-text-primary-default">+ New item</b>, duplicating a card, deleting one, and renaming inline by double-clicking a title.</li>
      </ul>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        Your working copy persists across a refresh, so you can step away mid-edit without losing anything.
      </p>

      <h3 class="text-single-base-medium text-text-primary-default mt-6 font-semibold">3. Attach evidence where it belongs</h3>
      <p class="text-body-md text-text-subtle-default mt-1.5 max-w-xl">
        Each item has one <b class="text-text-primary-default">Resources</b> section beneath its write-up. Choose <b class="text-text-primary-default">Add resource</b> there to upload files, paste a link, or search existing files and source documents.
        To put an image in your text, use the image button in that text’s toolbar. Choose an existing image, upload a new one, or paste an external image URL, then add alt text and insert it at your cursor. You can also paste images into the write-up. Uploaded images are also attached in Resources.
        Image resources show thumbnail previews. Choose <b class="text-text-primary-default">Edit</b> beside a resource to rename it, update its image descriptions, replace it, or remove a use. Removing a use keeps the original file available for reuse. Images use standard <code>![alt text](image-url)</code> Markdown and render in previews and published write-ups.
        Removing a placement keeps the file available. Deleting an unused file removes it from the current repository when you publish; Git history retains previous versions.
      </p>
      <p class="text-body-md text-text-subtle-default mt-1.5 max-w-xl">
        PNG, JPEG, GIF, WebP, PDF, MP4, WebM, Office, ZIP and text files are supported, up to 25 MiB each and 100 MiB per publication.
        Unpublished uploads are kept for 30 days. Published originals live in Git alongside the Markdown, with a checksum and a separate path for every revision.
        Replacing a file updates this item's references; other items keep their selected revision. Public items require Public files.
      </p>
      <h3 class="text-single-base-medium text-text-primary-default mt-6 font-semibold">4. Publish when the changes are ready</h3>
      <p class="text-body-md text-text-subtle-default mt-1.5 max-w-xl">
        <b class="text-text-primary-default">Review</b> lists your unpublished changes. <b class="text-text-primary-default">Publish changes</b> commits items, files and resource metadata together.
        The save bar first confirms the Git commit, then confirms when that version is live. You can keep writing while the site updates; those later edits remain in your draft.
        If the connection drops, retrying checks the original publication and avoids duplicate items or commits. Overlapping edits show both versions for review.
      </p>
      <p class="text-body-md text-text-subtle-default mt-1.5 max-w-xl">
        Leaving edit mode keeps your draft. Use Discard draft in the save bar to reset all unpublished changes; confirm the reset to remove the account draft too. Published items and files stay unchanged. If you are offline, the reset remains on this device until the account reconnects. Publishing does not change access permissions or update existing shares.
        When sharing, choose explicitly which links and published files to include; selected files are copied into that snapshot.
      </p>

      <h3 class="text-single-base-medium text-text-primary-default mt-6 font-semibold">The alternative: edit the file directly on GitHub</h3>
      <p class="text-body-md text-text-subtle-default mt-1.5 max-w-xl">
        Every item's <b class="text-text-primary-default">"Edit on GitHub"</b> link (in the detail drawer) opens
        that item's markdown file in GitHub's own web editor — frontmatter and body both, in one file. Good for a
        quick one-off fix, or when you'd rather open a PR for review than commit straight to <code class="text-single-sm-medium bg-surface-subtle-default rounded px-1.5 py-0.5">main</code>.
        Both paths edit the exact same file, so they're always interchangeable.
      </p>
    </section>

    <section id="latest-changes" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">Latest changes</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        A <b class="text-text-primary-default">"Recent changes"</b> card sits on the board itself, and its
        <b class="text-text-primary-default">"View all →"</b> link opens the full history page. Both are built
        straight from the repo's publication commit history — one commit
        (<a href="#editing" class="text-text-primary-default underline decoration-border-subtle-default underline-offset-4">Publish changes</a>
        or a direct commit) is one row.
      </p>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        Each row shows <b class="text-text-primary-default">who</b> changed things (the editor who published, not the
        bot that makes the commit), <b class="text-text-primary-default">what</b> (how many items were updated,
        created, deleted, or reordered, plus the titles of the items involved), a relative timestamp, and a
        link out to that <b class="text-text-primary-default">exact commit on GitHub</b>. A manual commit made
        outside the app (a direct push or PR) still shows up, using its raw commit message.
      </p>
    </section>

    <section id="new-with-ai" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">New with AI</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        In edit mode, <b class="text-text-primary-default">"New with AI"</b> sits beside "+ New item". Describe
        what the item should cover and pick a product, and AI (Sonnet) drafts a full spec — every relevant
        section filled in, plus a suggested stage, horizon, and tags — instead of you starting from a blank card.
      </p>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        The draft opens straight in the same full-screen editor you'd use for any item, as a normal
        <b class="text-text-primary-default">working-copy created item</b> — nothing about it is special or
        locked. Read it over, change anything you like, or delete it outright. Like every other edit, it's only a
        saved draft: <b class="text-text-primary-default">nothing publishes until you choose Publish changes</b>.
      </p>
    </section>

    <section id="rewrite-with-ai" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">Rewrite with AI</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        Inside the item editor, <b class="text-text-primary-default">"Rewrite with AI"</b> opens a conversational
        panel over the item you're already editing. Give it an instruction — "sharpen Why it matters", "add a
        risk to Open questions" — and it first tells you <b class="text-text-primary-default">what it would
        change</b>, in plain language. Nothing is rewritten yet at this point.
      </p>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        You can chat back and forth to steer the plan before committing to anything. When it looks right, hit
        <b class="text-text-primary-default">Apply</b>: the AI returns the full item rewritten, keeping the exact
        same section structure, and you get a <b class="text-text-primary-default">before/after diff, shown
        section by section</b>. <b class="text-text-primary-default">Accept</b> writes the rewrite into your
        working copy (same as any other edit — it publishes when you choose Publish changes); <b class="text-text-primary-default">
        Discard</b> throws it away and keeps your conversation so you can try again.
      </p>
    </section>

    <section id="presence" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">Live presence</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        The board shows a subtle <b class="text-text-primary-default">"N viewing"</b> indicator with avatars for
        who else is looking at it right now, visible to everyone. A viewer who goes quiet — no activity on the
        page — idles out of that count after about <b class="text-text-primary-default">10 minutes</b>; coming
        back and doing anything on the page rejoins it.
      </p>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        In edit mode specifically, you'll also see a soft <b class="text-text-primary-default">"X is also
        editing"</b> nudge when another editor is active at the same time. It's advisory only — a heads-up so you
        can coordinate — not a lock: the roadmap still works on a last-write-wins basis, and nothing stops either
        of you from publishing.
      </p>
      <div class="border-border-subtle-default bg-card mt-5 rounded-xl border px-4 py-3.5">
        <p class="text-body-md text-text-subtle-default max-w-xl">
          <b class="text-text-primary-default">Good to know:</b> New with AI, Rewrite with AI, and live presence
          all depend on the canvas Backend (AI + realtime) being enabled, so they only appear when it's on —
          they're simply absent, never broken, when it's off. Latest changes is different: it doesn't touch that
          Backend at all, it just reads the repo's own GitHub commit history, so it works everywhere the app does.
        </p>
      </div>
    </section>

    <section id="how-it-connects" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">How it connects to GitHub</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        In-app publishing, "Edit on GitHub", and a direct commit or PR all converge on the same files under
        <code class="text-single-sm-medium bg-surface-subtle-default rounded px-1.5 py-0.5">content/items/**</code> on
        <code class="text-single-sm-medium bg-surface-subtle-default rounded px-1.5 py-0.5">main</code>. A push there
        triggers a rebuild that redeploys this site, and a validation check runs on every change to catch a bad ID,
        a missing required field, or a misplaced file — gating the merge on a PR, flagging the problem after the
        fact on a direct push or publication. (There's no GitHub Project board in this pipeline — that integration is retired.)
      </p>
    </section>

    <section id="timeline" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">Planning on a timeline</h2>
      <p class="text-text-subtle-default mt-2 leading-relaxed">
        Switch between Board and Timeline without changing your filters. Add a planned start and end date in an item's editor; these dates save and publish with the rest of the item. They describe the intended work window and do not change its stage or Now / Next / Later horizon.
      </p>
      <p class="text-text-subtle-default mt-4 leading-relaxed">
        Group the timeline by product, owner, tag or stage, or choose None. Use Weeks, Months or Quarters to explore, Today to return to the current period, and Fit items to see all dated work. Items with multiple tags appear in each tag group, but the overall counts count each item once. Click a bar or title to open the item. Review missing dates to find items that need a start or end; dated items outside the visible period are counted separately.
      </p>
      <p class="text-text-subtle-default mt-4 leading-relaxed">
        Saved views remember the layout, grouping and date window. Shared cards group by product without Now / Next / Later labels. Timeline shares keep a fixed calendar window. Owner and tag grouping becomes product grouping when sharing, so private names and tags stay private.
      </p>
    </section>

    <section id="shares" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">Sharing a view</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        Use <b class="text-text-primary-default">View → Save as new view</b> to name a combination of
        filters, horizons, grouping, and sort order. Views are saved in this browser. Owner filters affect which
        items are selected for sharing; owner names and saved-view names are not included in the snapshot.
      </p>
      <p class="text-text-subtle-default mt-4 leading-relaxed">
        In Filters, use <b class="text-text-primary-default">Activity</b> to find items created or updated during a period. Choose Today, the last 7, 30 or 90 days, your own number of days, or an inclusive From–To range. Custom periods apply when you choose Apply. Updated includes any published item change in that period, even if the item changed again later; it also includes newly created items. Draft autosaves and site rebuilds do not count. Dates use the time zone shown in the filter. Relative periods keep rolling in saved views; shared snapshots keep the selected items and dates fixed.
      </p>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        The board’s <b class="text-text-primary-default">Share</b> action starts with exactly the items in your
        current filtered and sorted view. Review that list and deselect anything you do not want to include, then
        publish it as a read-only snapshot at its own URL. It is a point-in-time copy; later roadmap changes do not
        appear until you update that share.
      </p>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        In share settings, choose <b class="text-text-primary-default">Preview as recipient</b> to inspect the
        selected content in the published layout, at full width or mobile size. The preview follows the chosen
        light or dark appearance and includes selected empty lanes. It previews content; access still follows
        your sharing settings. Presentation mode is a view of the main roadmap and retains its access requirements.
      </p>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        New shares default to <b class="text-text-primary-default">Restricted</b>. You can instead choose Whole org
        or Public link, and optionally add a password. Manage expiry, added people, and teams in Canvas Drop.
        These are separate controls: no expiry is added automatically, and existing expiry and memberships remain
        in place when you update the content.
      </p>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        Updating an existing share keeps its URL and current settings unless you deliberately change them. An
        unpublished share stays in Shares and can be republished by updating it. Owner names, editing links, and
        linked documents, resources, and other internal-only fields are omitted from every snapshot.
        Review all selected content before choosing Public link; selecting an Internal item does not prevent you
        from including it in a share.
      </p>
      <p class="text-body-md text-text-subtle-default mt-3 max-w-xl">
        <b class="text-text-primary-default">Canvas owner</b> in the share list describes your management role on
        that Canvas Drop canvas. It is not the share’s audience, and it is unrelated to the owner of a roadmap item.
      </p>
    </section>

    <section id="why-no-dates" class="mt-10 scroll-mt-24">
      <h2 class="text-heading-md-semibold text-text-primary-default tracking-tight">Why no dates?</h2>
      <p class="text-body-md text-text-subtle-default mt-2 max-w-xl">
        Dates on a roadmap go stale the day they're written, and they force false certainty onto work we can't
        see clearly yet. Horizons don't. We commit to what's directly ahead and keep the rest flexible until we
        get there. The one date we promise is the ship date: when something ships, it moves to Completed.
      </p>
    </section>
      </article>
    </div>
  </main>
</Base>

