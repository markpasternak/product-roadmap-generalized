---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/ui/Breadcrumb.vue';
import { HORIZONS, STAGES, PRODUCTS } from '../lib/schema';
import { horizonDot, horizonDescription, productColor, productShort } from '../lib/display';

const base = import.meta.env.BASE_URL;

const STAGE_DESCRIPTION: Record<(typeof STAGES)[number], string> = {
  Discovery: 'Exploring the problem. Nothing is committed yet.',
  Validation: 'Testing the problem and proposed approach with users and evidence.',
  Shaping: 'Defining the scope and approach.',
  Committed: 'Agreed for delivery and queued to begin.',
  Building: 'In active development.',
  Pilot: 'Live with a limited set of users before general availability.',
  Shipped: 'Generally available.',
  Parked: 'On hold on purpose. Kept for the record.',
};

const TOC = [
  { href: '#mental-model', label: 'Priorities, progress and dates' },
  { href: '#horizons', label: 'Horizons' },
  { href: '#stages', label: 'Stages' },
  { href: '#reading-the-board', label: 'Board, filters and views' },
  { href: '#timeline', label: 'Timeline and planned dates' },
  { href: '#other-fields', label: 'Item fields' },
  { href: '#editing', label: 'Drafts and publishing' },
  { href: '#resources', label: 'Files, links and images' },
  { href: '#new-with-ai', label: 'Working with AI' },
  { href: '#latest-changes', label: 'Changes and collaboration' },
  { href: '#how-it-connects', label: 'GitHub and the source of truth' },
  { href: '#shares', label: 'Sharing a snapshot' },
];
---

<Base
  title="How the roadmap works · Roadmap"
  active="help"
  description="A practical guide to priorities, timelines, editing and sharing the roadmap."
>
  <main class="support-page page-reveal mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <Breadcrumb items={[{ label: 'Roadmap', href: base }, { label: 'Help' }]} />
    <section class="roadmap-masthead mt-6 rounded-[20px] px-5 py-5 sm:px-6 sm:py-6 lg:px-7">
      <p class="roadmap-label">Roadmap guide</p>
      <h1 class="roadmap-display roadmap-title mt-2 text-[2rem] sm:text-[2.55rem]">How the roadmap <em>works.</em></h1>
      <p class="roadmap-muted text-body-lg mt-3 max-w-2xl">
        Start with <b class="roadmap-title">what matters and what comes next</b>. Use Now / Next / Later to
        communicate priorities and direction, and Timeline to see planned work windows when dates are useful.
      </p>
      <p class="roadmap-muted text-body-md mt-2 max-w-2xl">
        The same items power both views. Dates add detail; you do not need them to put an idea on the roadmap.
      </p>
    </section>

    <div class="mt-5 grid items-start gap-5 lg:grid-cols-[230px_minmax(0,1fr)]">
      <nav class="roadmap-glass rounded-2xl p-3 lg:sticky lg:top-17" aria-label="On this page">
        <details class="lg:hidden">
          <summary class="text-single-sm-medium text-text-primary-default flex cursor-pointer items-center justify-between gap-3 px-2 py-1 font-semibold">
            <span class="roadmap-label">On this page</span>
            <span class="text-text-subtle-default font-normal">{TOC.length} sections</span>
          </summary>
          <ul class="mt-2 grid gap-0.5 sm:grid-cols-2">
            {
              TOC.map((t, index) => (
                <li>
                  <a
                    href={t.href}
                    class="roadmap-action text-single-sm-medium text-text-subtle-default hover:bg-surface-primary-hover hover:text-text-primary-default flex items-start gap-2 rounded-lg px-2 py-1.5"
                  >
                    <span class="mt-0.5 w-5 shrink-0 text-right text-[0.68rem] tabular-nums opacity-55">{String(index + 1).padStart(2, '0')}</span>
                    <span>{t.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </details>

        <div class="hidden lg:block">
          <p class="roadmap-label px-2 pt-1">On this page</p>
          <ul class="mt-2 grid gap-0.5">
            {
              TOC.map((t, index) => (
                <li>
                  <a
                    href={t.href}
                    class="roadmap-action text-single-sm-medium text-text-subtle-default hover:bg-surface-primary-hover hover:text-text-primary-default flex items-start gap-2 rounded-lg px-2 py-1.5"
                  >
                    <span class="mt-0.5 w-5 shrink-0 text-right text-[0.68rem] tabular-nums opacity-55">{String(index + 1).padStart(2, '0')}</span>
                    <span>{t.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>

      <article class="help-article roadmap-panel rounded-[24px] px-5 pb-8 sm:px-7 lg:px-9">

    <section id="mental-model" class="mt-10 scroll-mt-24">
      <h2>Priorities first. Dates when they help.</h2>
<p>The roadmap helps you understand what we are working toward, why it matters and what comes next.
        <b>Horizon</b> describes priority and sequence. <b>Stage</b> describes progress.
        <b>Planned start and end dates</b> describe the intended work window. These are separate choices.</p>
      <p>For example, an item can be in Now, still in Shaping, and have a planned start next month.
        Moving it to Now does not start it automatically, and reaching its end date does not mark it shipped.</p>
      <p>Use Board for the overall direction and Timeline for timing and overlaps. Dates are planning assumptions
        to review as the work changes, rather than a requirement for every idea.</p>
    </section>

    <section id="horizons" class="mt-10 scroll-mt-24">
      <h2>Horizons: priority and sequence</h2>
<p>The default board shows Now, Next and Later. Open <b>View → Show horizons</b> to include Candidates
        or Completed, or hide horizons you do not need. This also controls which items are considered in Timeline.</p>
      <div class="help-reference-list">
        {HORIZONS.map((h) => (
          <div class="help-reference-row">
            <b><span class="size-2.5 shrink-0 rounded-full" style={`background:${horizonDot[h]}`} />{h}</b>
            <span>{horizonDescription[h]}</span>
          </div>
        ))}
      </div>
      <p>Horizons have no fixed duration: Next does not mean next month. Clearing filters keeps your horizon
        choices. When they differ from the default, the summary above the items offers a separate Reset.</p>
    </section>

    <section id="stages" class="mt-10 scroll-mt-24">
      <h2>Stages: progress through the work</h2>
<p>Stage tells you how far the work has progressed, independently of its horizon and dates.</p>
      <div class="help-reference-list">
        {STAGES.map((stage) => (
          <div class="help-reference-row"><b>{stage}</b><span>{STAGE_DESCRIPTION[stage]}</span></div>
        ))}
      </div>
    </section>

    <section id="reading-the-board" class="mt-10 scroll-mt-24">
      <h2>Board, filters and saved views</h2>
<p>Choose a product, search for an item, or open a card to read its full write-up and resources.
        Switch between <b>Board</b> and <b>Timeline</b> without losing your current selection.</p>
      <dl>
        <div><dt>Filters — which items to show</dt><dd>Filter by stage, impact, effort, tags or activity.
          Internal views also offer owner and visibility. Clear all removes these filters while keeping the
          selected product and view settings.</dd></div>
        <div><dt>View — how to show them</dt><dd>Choose visible horizons and manage your saved views.
          On Board, choose grouping by horizon or product and a sort order: Priority, Highest impact, Lowest effort,
          Recently updated or Title. Timeline has its own grouping and scale controls. Horizons, grouping, sort order
          lane order and whether card covers are shown stay in this browser. A link with explicit view settings takes precedence without replacing
          those browser preferences.</dd></div>
        <div><dt>Reverse lane order</dt><dd>Reverse the displayed lanes or Timeline groups without changing item priority.
          It is included in saved views, presentation links and shared snapshots.</dd></div>
      </dl>
      <h3>Find recently created or updated items</h3>
      <p>In <b>Filters → Activity</b>, choose Created or Updated, then Today, the last 7, 30 or 90 days,
        a custom number of days, or an inclusive From–To range. Choose Apply for a custom period.
        The filter shows the time zone it uses.</p>
      <p>Updated includes any published item change within the period, even if the item changed again later.
        Newly created items count too. Draft autosaves and site rebuilds do not count.
        These activity dates describe publication history; they are separate from planned start and end dates.</p>
      <h3>Keep a useful view</h3>
      <p>Choose <b>View → Save as new view</b> to name your current filters, horizons, layout, grouping, sort, lane order and cover-image setting.
        Timeline settings are saved too. You can update, rename or delete saved views in the same menu.
        They are stored in this browser, not synced to your account; clearing browser data removes them.
        A saved “last 7 days” filter keeps rolling as time passes.</p>
      <p><b>Actions</b> contains presentation, presentation-link and full-screen controls, plus Recent changes.
        Presentation keeps the current horizons, grouping, sort, lane order, layout and cover setting. It gives cards more room,
        hides working controls, and keeps the roadmap's existing access rules.
        Use Account for editing sign-in and appearance; read-only deployments may show Appearance instead.</p>
      <p>Press <kbd>/</kbd> to search or <kbd>?</kbd> to see keyboard shortcuts.</p>
    </section>

    <section id="timeline" class="mt-10 scroll-mt-24">
      <h2>Timeline and planned dates</h2>
<span id="why-no-dates" class="scroll-mt-24"></span>
      <p>Add a <b>planned start</b> and <b>planned end</b> in the item editor. The end must be on or after the start.
        The dates appear on the item and as a bar in Timeline after saving your edit. They publish with the rest of the item.</p>
      <p><b>Both dates are required to draw a bar.</b> Items with missing or invalid dates remain on the roadmap,
        but are omitted from the chart. The count above Timeline shows how many; choose Review to see and open them.
        Items with valid dates outside the visible period are counted separately.</p>
      <p>Group by Product, Owner, Tag, Stage or None. Use Weeks, Months or Quarters for the scale, the arrows to
        move through time, Today to return to the current period, and Fit items to see all dated work in your selection.
        Click a bar or title to open the item. The vertical line marks today.</p>
      <p>An item with several tags appears in each relevant tag group, while the overall count counts it once.
        Owner and tag grouping are unavailable in public and presentation views. Neither dates nor a bar's position change the
        item's stage, horizon or priority.</p>
    </section>

    <section id="other-fields" class="mt-10 scroll-mt-24">
      <h2>What an item contains</h2>
<span id="products" class="scroll-mt-24"></span>
      <p>Give each item a clear title and a write-up explaining the problem, why it matters and what will ship.
        Add detail where it helps someone understand a decision.</p>
      <dl>
        <div><dt>Product</dt><dd>Each item belongs to one product. Choose a product to focus the roadmap,
          or group by product to compare tracks.</dd></div>
        <div><dt>Owner</dt><dd>The person accountable for the item. Owner names appear in internal views,
          but are omitted from public builds and shared snapshots.</dd></div>
        <div><dt>Impact and effort</dt><dd>Optional Low, Medium or High estimates of value and work.
          Use them to compare ideas; an unscored item can still belong on the roadmap.</dd></div>
        <div><dt>Tags</dt><dd>Labels for finding related work. Tags can also group items on Timeline.</dd></div>
        <div><dt>Visibility</dt><dd>Internal or Public. This controls inclusion in a public build of the roadmap.
          A separately published share has its own selected items and access settings; an Internal item can be
          included in a share, so review the content and audience before publishing.</dd></div>
        <div><dt>Priority</dt><dd>The manual order within one product and horizon. It is separate from
          stage, planned dates and the temporary sort order you choose for viewing.</dd></div>
      </dl>
      <div class="help-products" aria-label="Products in this roadmap">
        {PRODUCTS.map((product) => (
          <span><b style={`color:${productColor[product]}`}>{productShort[product]}</b>{product}</span>
        ))}
      </div>
    </section>

    <section id="editing" class="mt-10 scroll-mt-24">
      <h2>Drafts, saving and publishing</h2>
<p>When editing is enabled, use <b>Account → Sign in to edit</b> and sign in with GitHub.
        You need write access to the roadmap repository. Choose Edit to make changes; opening a card then opens its editor.</p>
      <h3>Work in a private draft</h3>
      <p>Edits save on this device, then sync to your account when connected. The save bar reports that status
        and your unpublished changes. <b>A saved draft is not published to GitHub or the live site.</b>
        Leaving edit mode keeps the draft. Check the save status before leaving, especially if you are offline.</p>
      <p>Use the section overview to move between the same section cards readers see, expand long sections when needed,
        or use whole-body Markdown. The left rail keeps the initiative's decisions and card preview in view while you write.
        Choose the changed count in the header for a before-and-after review and to jump to a changed field or write-up.
        You can create, duplicate or delete items. Drag between horizon lanes to change a horizon.
        To reorder priority, choose one product, sort by Priority and clear other filters.</p>
      <h3>Review, then publish</h3>
      <p><b>Review</b> shows the unpublished changes. <b>Publish changes</b> commits your
        item changes, uploaded files and resource metadata together. The save bar distinguishes saved to Git
        from confirmed live on the site. You can keep editing while the site updates; those later edits stay in your draft.</p>
      <p>If GitHub sign-in is missing or expires, sign in again with the same account; your draft is kept.
        The editing session lasts up to seven days, but lost repository access or a revoked session can require
        an earlier sign-in. If a connection fails during publication, retrying checks the previous attempt first.</p>
      <p>When another published change overlaps yours, the app asks you to review both versions before publishing.
        Conflicting account drafts also need review. Resolve the differences rather than overwriting work blindly.</p>
      <h3>Discard a draft</h3>
      <p>Use <b>Discard draft</b> in the save bar and confirm to reset unpublished changes.
        Published items and files stay unchanged, and a recovery copy is kept on this device.
        If offline, the account reset waits for reconnection. Publishing does not update existing shares or change access permissions.</p>
    </section>

    <section id="resources" class="mt-10 scroll-mt-24">
      <h2>Files, links and inline images</h2>
<p>Each item has one <b>Resources</b> section beneath the write-up. Choose <b>Add resource</b> there
        to upload a file, paste a link, or find an existing file or source document.</p>
      <p>To place an image within your writing, use the <b>image button in that text's toolbar</b>.
        Select existing images, upload several at once, or paste an external image URL. The picker starts with this
        item's images and your uploads; open <b>Shared library</b> to reuse other people's files. Filenames appear
        below the thumbnails. Use <b>Filter by name</b> to find an image by its name or filename within the selected library.
        Filtering keeps your selections. Add descriptive alt text and insert at the cursor. You can also paste images into the editor.</p>
      <p>Click an image in an initiative to open a large viewer. Use <b>Zoom in</b>, <b>Zoom out</b> and <b>Fit</b>,
        and scroll to inspect a zoomed image. Previous and next show only images from that initiative, in reading order.
        Escape closes the image and returns to the initiative.</p>
      <p>Images use standard Markdown: <code>![alt text](image-url)</code>.
        They render in the editor preview and published write-up. Attaching a resource and placing it inline are
        separate uses of the same file.</p>
      <p>Choose <b>Edit</b> beside a resource to change its name or image description, replace the file or remove
        a use. Removing a use keeps the file in the library. Replacing a file updates this item's references;
        other items keep their chosen revision. Delete from library is available when the file has no remaining uses.</p>
      <p>Under <b>Add resource → Choose existing</b>, resources appear in a visual gallery. Selecting one opens a side inspector
        without moving the editor. Image thumbnails stay visible and <b>Preview</b> opens the
        original in a new tab. Use <b>Open</b> to inspect another file or document before attaching it. These actions
        remain available for resources that are already attached.</p>
      <p>An attached image can also become the card's cover. Choose <b>Use as cover</b>, then click or drag directly
        on the image to keep its subject in focus. The roadmap-card and reader-header previews show how that focal point
        survives both crops. Cover cards use the full image with a translucent, contrast-safe information panel;
        opening the initiative shows the same image as a wide masthead, including in baked shares. Removing the cover
        keeps the original image attached.</p>
      <p>Uploads support common image, document, video, archive and text formats, up to 25 MiB per file and
        100 MiB per publication. Unpublished uploads expire after 30 days.
        Published originals and revisions live in Git. Deleting a file on publication removes the current copy,
        while Git history retains earlier versions. Public items require Public files.</p>
    </section>

    <section id="new-with-ai" class="mt-10 scroll-mt-24">
      <h2>Working with AI</h2>
<span id="rewrite-with-ai" class="scroll-mt-24"></span>
      <p>When AI is enabled, <b>New with AI</b> drafts an item from your description and chosen product.
        It opens as an ordinary draft: review the reasoning, scope, fields and suggested details before publishing.</p>
      <p>Inside an item, <b>Rewrite with AI</b> lets you discuss a change first. Apply generates a proposed rewrite
        and a section-by-section comparison. Accept puts it in your draft; Discard keeps the original text.
        Accepting AI text does not publish it.</p>
    </section>

    <section id="latest-changes" class="mt-10 scroll-mt-24">
      <h2>Recent changes and collaboration</h2>
<span id="presence" class="scroll-mt-24"></span>
      <p>Open <b>Actions → Recent changes</b> for publication history. Entries show the changes, their author and time,
        and a link to the Git commit. This history records publications, not private draft edits.
        Use Activity filters to find the items changed in a particular period.</p>
      <p>When live presence is enabled, the viewing indicator shows other active viewers and an editing notice
        helps editors coordinate. It does not lock items or share your private draft with everyone.
        Publication conflicts are reviewed in the save flow.</p>
    </section>

    <section id="how-it-connects" class="mt-10 scroll-mt-24">
      <h2>GitHub is the published source of truth</h2>
<p>Each published roadmap item is a Markdown file in the GitHub repository, with fields and a write-up.
        Uploaded files and resource metadata are stored there too. Private drafts are temporary working copies
        held separately until publication.</p>
      <p>Publishing commits those changes and triggers a site rebuild. A Git commit can be complete before the
        updated site is live; the save bar makes that distinction. The item’s Edit on GitHub link, where available,
        opens the same source file for direct editing or a pull request. Repository checks validate the content and build.</p>
    </section>

    <section id="shares" class="mt-10 scroll-mt-24">
      <h2>Share a snapshot with its own audience</h2>
      <p>In an open initiative, <b>Copy item link</b> copies a URL that opens that initiative directly.
        Shared item links stay within the shared roadmap and use the same password and access rules.
        Closing the initiative returns to the roadmap. Use <b>Expand</b> for more reading space and <b>Collapse</b> to return to the compact view.
        Your last choice is remembered across items and visits in this browser. Each shared roadmap remembers the recipient's own choice;
        it is not part of the published content. Closing an item does not reset it.
        Expanded items with several sections show <b>On this page</b> navigation on wide screens. Select a heading to jump to that section.</p>
<p><b>Share</b> creates a separate, read-only snapshot of the selected roadmap content at its own URL.
        It is different from a local saved view or a link to the live roadmap. Later roadmap edits do not appear
        in a snapshot until you update that share.</p>
      <ol>
        <li>Start from the view you want to share. Review the item list and deselect anything you do not want included.</li>
        <li>Inline images in the shared text are included automatically. Choose any additional links and files.
          Published uploaded files are copied into the snapshot; publish new uploads before sharing them.</li>
        <li>Use <b>Preview as recipient</b> to check the selected content and appearance at desktop or mobile size.</li>
        <li>Choose the audience and publish a new share, or update an existing one.</li>
      </ol>
      <p>Card titles use up to three lines. Hover or focus a card to read a clipped title in full; open the item for its full write-up.
        Shared cards keep the board's grouping, sort, lane order and cover-image setting. Selected covers are copied
        into the snapshot automatically. Presentation mode and shared snapshots use the same masthead, lane, card, cover and
        item-reader styles, so the recipient page matches the view you reviewed. Selected empty horizon lanes stay visible.
        Cards show the work stage. When horizon lanes mix products, cards show the product shorthand; the shorthand
        is hidden for a single product and when product lanes already provide that context. Product lanes show the horizon instead.
        The Completed lane is visually quieter.
        <b>Scope</b> covers both planned and delivered work, including older sections named What ships or What shipped.
        Bottom line is included when present. Timeline shares keep a fixed
        calendar window; owner or tag grouping changes to product grouping.</p>
      <p>Owner fields and editing links are omitted. Inline images are included with the text; other resources are optional.
        Review the write-up itself too: a name or sensitive detail typed into the text is still content you are sharing.
        The preview shows content and layout; your access settings determine who can open it.</p>
      <p>New shares default to <b>Restricted</b>. You can choose Whole org or Public link and optionally add a password.
        Manage people, teams and expiry in Canvas Drop. No expiry is added automatically.</p>
      <p>Updating a share keeps its URL, expiry and existing memberships. Access settings stay as they are unless
        you change them. File selections are remembered for shares published with this version. Reload an already-open
        recipient page after updating it. Use Shares to find and manage published snapshots; an unpublished share can be published again
        by updating it. “Canvas owner” describes your management role, not the audience or an item's owner.</p>
    </section>

      </article>
    </div>
  </main>
</Base>

<style>
  .help-article h2 { color: var(--color-text-primary-default); font-size: 1.25rem; font-weight: 600; line-height: 1.35; letter-spacing: -.02em; }
  .help-article h3, .help-article dt { color: var(--color-text-primary-default); font-weight: 600; }
  .help-article h3 { margin-top: 1.5rem; }
  .help-article p, .help-article dd, .help-article li { color: var(--color-text-subtle-default); line-height: 1.7; }
  .help-article p { margin-top: .75rem; }
  .help-article b { color: var(--color-text-primary-default); }
  .help-article dl { display: grid; gap: 1rem; margin-top: 1rem; }
  .help-article dd { margin: .25rem 0 0; }
  .help-article ol { margin: 1rem 0 0; padding-left: 1.4rem; list-style: decimal; }
  .help-article li + li { margin-top: .6rem; }
  .help-article code, .help-article kbd { background: var(--color-surface-subtle-default); border-radius: 4px; padding: .1rem .3rem; font-size: .875em; overflow-wrap: anywhere; }
  .help-reference-list { display: grid; gap: .5rem; margin-top: 1.25rem; }
  .help-reference-row { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 1rem; padding: .85rem 1rem; border: 1px solid var(--color-border-subtle-default); border-radius: 8px; line-height: 1.5; color: var(--color-text-subtle-default); }
  .help-reference-row > b { display: flex; align-items: center; gap: .5rem; }
  .help-products { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin-top: 1.25rem; font-size: .8125rem; color: var(--color-text-subtle-default); }
  .help-products > span { display: flex; align-items: center; gap: .4rem; }
  @media (max-width: 480px) { .help-reference-row { grid-template-columns: 1fr; gap: .3rem; } }

  .help-article > section:first-child {
    margin-top: 0;
    padding-top: 2rem;
  }

  .help-article > section + section {
    border-top: 1px solid var(--color-border-subtle-default);
    padding-top: 2.25rem;
  }

  @media (min-width: 640px) {
    .help-article > section:first-child {
      padding-top: 2.5rem;
    }
  }
</style>
