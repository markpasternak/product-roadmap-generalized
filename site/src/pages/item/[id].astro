---
import { renderRichMarkdown } from '../../lib/richMarkdown';
import { STORY_HEADINGS, sectionLabel } from '../../lib/sectionHeadings';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Breadcrumb from '../../components/ui/Breadcrumb.vue';
import PlannedDates from '../../components/board/PlannedDates.vue';
import ProductMark from '../../components/ui/ProductMark.vue';
import {
  horizonDot,
  productColor,
  toneSurface,
  toneSurfaceStrong,
  toneText,
  tagTone,
} from '../../lib/display';
import { parseLinks, parseSections, parseTags, sectionText, byHorizonThenOrder, docTargetKey } from '../../lib/items';
import { linkSource } from '../../lib/sources';
import { productSlug } from '../../lib/slugs';
import { formatDateTime, formatDateTimeOrDate } from '../../lib/dates';
import { itemHistoryForPath } from '../../lib/itemHistory.server';
import type { ItemLink } from '../../lib/items';
import { isImageResource, resourceHref } from '../../lib/resources';
import { IS_PUBLIC } from '../../lib/audience';
import { coverPresentationCss } from '../../lib/coverPresentation';
import {
  PhArrowSquareOut as _PhArrowSquareOut,
  PhCaretLeft as _PhCaretLeft,
  PhCaretRight as _PhCaretRight,
  PhFileText as _PhFileText,
  PhLink as _PhLink,
  PhPencilSimple as _PhPencilSimple,
} from '@phosphor-icons/vue';
import { getVisibleDocCollections } from '../../lib/docs';

const PhArrowSquareOut = _PhArrowSquareOut as any;
const PhCaretLeft = _PhCaretLeft as any;
const PhCaretRight = _PhCaretRight as any;
const PhFileText = _PhFileText as any;
const PhLink = _PhLink as any;
const PhPencilSimple = _PhPencilSimple as any;

export async function getStaticPaths() {
  const items = (await getCollection('items')).filter(
    (entry) => !IS_PUBLIC || entry.data.visibility === 'Public',
  );
  items.sort((a, b) => byHorizonThenOrder(a.data, b.data));
  return items.map((entry, i) => {
    const sibling = (e: (typeof items)[number] | undefined) =>
      e ? { id: e.data.id, title: e.data.title } : null;
    return {
      params: { id: entry.data.id },
      props: { entry, prev: sibling(items[i - 1]), next: sibling(items[i + 1]) },
    };
  });
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const base = import.meta.env.BASE_URL;
const body = entry.body ?? '';
const links = parseLinks(body, base);
const title = d.title;
const lede = sectionText(body, 'One-liner');
const { tags, themes } = parseTags(d.tags);
const REPO_EDIT_BASE = 'https://github.com/markpasternak/product-roadmap-generalized/edit/main';
const repoPath = entry.filePath ? entry.filePath.slice(entry.filePath.indexOf('content/items/')) : null;
const history = itemHistoryForPath(repoPath);
const editUrl = !IS_PUBLIC && repoPath ? `${REPO_EDIT_BASE}/${repoPath}` : null;
const created = formatDateTimeOrDate(history.createdAt, history.created);
const updated = formatDateTimeOrDate(history.updatedAt, history.updated);
const cover = d.cover ? resourceHref(d.cover, base) : '';
const coverStyle = coverPresentationCss(d.coverPosition, d.coverFraming);
const historyTitle = (at: string, by: string, subject: string): string =>
  [at ? formatDateTime(at) : '', by, subject].filter(Boolean).join(' · ');

// The board card/drawer shows the fixed sections; the full page renders every
// section the file has, in file order. Public builds keep the curated set only
// (deeper detail like "Current behavior (in repo)" stays internal).
const PUBLIC_SECTIONS = new Set([...STORY_HEADINGS, 'Target outcome', "Who it's for"]);
const HIDDEN_SECTIONS = new Set(['One-liner', 'Links', 'Resources']);
const storySections = parseSections(body)
  .filter((s) => !HIDDEN_SECTIONS.has(s.heading))
  .filter((s) => !IS_PUBLIC || PUBLIC_SECTIONS.has(s.heading))
  .map((s) => ({ heading: sectionLabel(s.heading), html: renderRichMarkdown(s.raw, base) }));

const docColls = await getVisibleDocCollections();
const docTitleByTarget = new Map<string, string>();
for (const { root, entries } of docColls)
  for (const e of entries)
    if (e.data.title) docTitleByTarget.set(`${root}/${e.id}`.toLowerCase(), e.data.title);
const prettifySlug = (s: string): string =>
  (s.split('/').filter(Boolean).pop() ?? '').replace(/[-_]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
// Never render a raw URL as flowing text — show the host, keep the full URL on hover.
const externalHost = (target: string): string => {
  try {
    return new URL(target).hostname.replace(/^www\./, '');
  } catch {
    return target;
  }
};
const linkText = (ln: ItemLink): string =>
  ln.kind === 'external'
    ? externalHost(ln.target)
    : ln.kind === 'presentation'
      ? prettifySlug(ln.href)
      : (docTitleByTarget.get(docTargetKey(ln.target) ?? '') ?? ln.target.split('/').pop() ?? ln.target);

const details: { label: string; value: string; href?: string; color?: string; datetime?: string; title?: string; localDateTime?: boolean }[] = [
  { label: 'Product', value: d.product, href: `${base}${productSlug(d.product)}/` },
  ...(!IS_PUBLIC && d.owner ? [{ label: 'Owner', value: d.owner }] : []),
  ...(created ? [{ label: 'Created', value: created, datetime: history.createdAt || history.created, title: historyTitle(history.createdAt ?? '', history.createdBy ?? '', history.createdSubject ?? ''), localDateTime: !!history.createdAt }] : []),
  ...(updated ? [{ label: 'Updated', value: updated, datetime: history.updatedAt || history.updated, title: historyTitle(history.updatedAt ?? '', history.updatedBy ?? '', history.updatedSubject ?? ''), localDateTime: !!history.updatedAt }] : []),
  ...(links.length ? [{ label: 'Resources', value: String(links.length) }] : []),
  { label: 'Item ID', value: d.id },
];
function tagFilterHref(token: string): string {
  const params = new URLSearchParams();
  params.set('tag', token);
  return `${base}?${params.toString()}`;
}
---

<Base title={`${title} · Product Roadmap`} active="roadmap" description={lede || `${d.product} roadmap item ${d.id}`} ogType="article">
  <main
    class="page-reveal mx-auto max-w-[1440px] px-4 pb-10 sm:px-7"
    data-item-page
    data-prev-href={prev ? `${base}item/${prev.id}` : undefined}
    data-next-href={next ? `${base}item/${next.id}` : undefined}
  >
    <section style={`--roadmap-product-accent:${productColor[d.product]}`} class="roadmap-masthead roadmap-product-detail -mx-4 rounded-b-[22px] px-5 py-3 sm:mx-0 sm:mt-4 sm:rounded-[22px] sm:px-6 lg:px-7">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <Breadcrumb items={[{ label: 'Roadmap', href: base }, { label: d.id }]} />
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={prev ? `${base}item/${prev.id}` : undefined}
            title={prev ? `Previous: ${prev.title}` : undefined}
            class:list={[
              'roadmap-action grid size-10 place-items-center rounded-lg border bg-card/80',
              prev ? 'border-border-subtle-default text-icons-subtle-default hover:text-text-primary-default' : 'pointer-events-none border-border-subtle-default text-icons-subtle-default opacity-30',
            ]}
            aria-label={prev ? `Previous item: ${prev.title}` : 'No previous item'}
          >
            <PhCaretLeft size={19} />
          </a>
          <a
            href={next ? `${base}item/${next.id}` : undefined}
            title={next ? `Next: ${next.title}` : undefined}
            class:list={[
              'roadmap-action grid size-10 place-items-center rounded-lg border bg-card/80',
              next ? 'border-[color:var(--color-accent-brand-default)] text-[color:var(--color-accent-brand-default)]' : 'pointer-events-none border-border-subtle-default text-icons-subtle-default opacity-30',
            ]}
            aria-label={next ? `Next item: ${next.title}` : 'No next item'}
          >
            <PhCaretRight size={19} />
          </a>
          <button type="button" data-copy-link class="roadmap-action inline-flex h-10 items-center gap-2 rounded-lg border border-border-subtle-default bg-card/80 px-3.5 text-single-sm-medium text-text-primary-default sm:inline-flex">
            <PhLink size={18} /> <span data-copy-label>Copy link</span>
          </button>
          {editUrl && (
            <a href={editUrl} target="_blank" rel="noopener" class="roadmap-action hidden h-10 items-center gap-2 rounded-lg border border-border-subtle-default bg-card/80 px-3.5 text-single-sm-medium text-text-primary-default sm:inline-flex">
              <PhPencilSimple size={18} /> Edit on GitHub
            </a>
          )}
        </div>
      </div>

      <p data-copy-status role="status" class="mt-2 text-sm text-text-subtle-default empty:hidden"></p>
      <div class:list={['item-page-hero', cover && 'has-cover', d.horizon === 'Completed' && 'is-completed']}>
        {cover && <div class="item-page-cover roadmap-cover-media" aria-hidden="true" style={coverStyle}><img class="roadmap-cover-backdrop" src={cover} alt="" decoding="async" /><img class="roadmap-cover-fill" src={cover} alt="" decoding="async" /><img class="roadmap-cover-reveal" src={cover} alt="" decoding="async" /><span class="item-page-cover-treatment" /></div>}
        <div class="item-page-hero-copy">
          <ProductMark product={d.product} size={40} />
          <div class="min-w-0">
            <h1 class="roadmap-display roadmap-title">{title}</h1>
            {lede && <p class="roadmap-muted mt-1.5 max-w-3xl text-sm leading-relaxed sm:text-base">{lede}</p>}
          </div>
        </div>
      </div>

      <dl class="item-page-status-summary">
        <div><dt>Horizon</dt><dd><span style={`background:${horizonDot[d.horizon]}`} />{d.horizon}</dd></div>
        <div><dt>Stage</dt><dd>{d.stage}</dd></div>
        <div><dt>Impact</dt><dd>{d.impact || 'Not scored'}</dd></div>
        <div><dt>Effort</dt><dd>{d.effort || 'Not scoped'}</dd></div>
      </dl>
    </section>

    <div class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,1fr)_340px]">
      <article class="min-w-0">
        <PlannedDates startDate={d.startDate} endDate={d.endDate} />

        <section class="mt-3">
          <div class="space-y-5">
            {storySections.map((s) => {
              return (
                <section class="item-reading-section item-section-surface">
                  <div class="min-w-0">
                    <h2 class="roadmap-section-heading">{s.heading}</h2>
                    <div class="resource-markdown item-prose mt-1.5 text-base leading-relaxed text-text-primary-default" set:html={s.html} />
                  </div>
                </section>
              );
            })}
          </div>
          {(tags.length > 0 || themes.length > 0) && (
            <div class="mt-6 flex flex-wrap gap-2">
              {themes.map((t) => (
                <a href={tagFilterHref(`theme:${t}`)} class="text-single-sm-medium relative inline-flex min-h-8 items-center rounded-lg border border-border-subtle-default/60 px-2.5 py-1 after:absolute after:-inset-x-1 after:-inset-y-1 hover:underline" style={`background:${toneSurface.orange};color:${toneText.orange}`}>
                  {t}
                </a>
              ))}
              {tags.map((t) => (
                <a href={tagFilterHref(t)} class="text-single-sm-medium relative inline-flex min-h-8 items-center rounded-lg border border-border-subtle-default/60 px-2.5 py-1 after:absolute after:-inset-x-1 after:-inset-y-1 hover:underline" style={`background:${toneSurface[tagTone(t)]};color:${toneText[tagTone(t)]}`}>
                  {t}
                </a>
              ))}
            </div>
          )}
        </section>
      </article>

      <aside class="flex flex-col gap-5 lg:sticky lg:top-20 lg:self-start">
        {links.length > 0 && (
          <section class="roadmap-panel rounded-[22px] p-4">
            <h2 class="font-display roadmap-title flex items-center gap-2 text-[1.35rem] leading-none">
              <PhFileText size={20} /> Related resources
            </h2>
            <div class="mt-4 grid grid-cols-[minmax(0,1fr)] gap-2.5">
              {links.map((ln) => {
                const src = linkSource(ln.label, ln.target);
                const Icon = src.Icon as any;
                return (
                  <a
                    href={ln.href}
                    target={ln.kind === 'external' || ln.kind === 'presentation' ? '_blank' : undefined}
                    rel={ln.kind === 'external' || ln.kind === 'presentation' ? 'noopener' : undefined}
                    class="roadmap-action flex min-w-0 items-center gap-3 rounded-xl border border-border-subtle-default bg-card/70 px-3 py-2.5 hover:bg-card"
                  >
                    {ln.image || isImageResource(ln.target) ? <img src={ln.href} alt="" loading="lazy" decoding="async" class="h-16 w-20 shrink-0 rounded-lg border border-border-subtle-default object-contain" /> : <span class="grid size-9 shrink-0 place-items-center rounded-lg" style={`background:${toneSurfaceStrong[src.tone]};color:${toneText[src.tone]}`}>
                      <Icon size={19} />
                    </span>}
                    <span class="min-w-0 flex-1">
                      <span class="text-single-sm-medium block whitespace-normal font-semibold" style={`color:${toneText[src.tone]}`}>
                        {ln.label}
                      </span>
                      <span class="text-single-base-medium text-text-primary-default block whitespace-normal break-words leading-snug" title={ln.kind === 'external' ? ln.target : undefined}>
                        {linkText(ln)}
                      </span>
                    </span>
                    <span class="text-single-sm-medium inline-flex shrink-0 items-center gap-1.5 text-text-subtle-default">
                      Open <PhArrowSquareOut size={17} />
                    </span>
                  </a>
                );
              })}
            </div>
            <a href={`${base.replace(/\/$/, '')}/docs`} class="roadmap-action mt-3 flex h-10 items-center justify-center gap-2 rounded-lg border border-border-subtle-default bg-card/70 text-single-sm-medium text-text-primary-default hover:bg-card">
              <PhFileText size={18} /> Browse source documents
            </a>
          </section>
        )}

        <section class="roadmap-panel rounded-[22px] p-4">
          <h2 class="font-display roadmap-title text-[1.35rem] leading-none">Item details</h2>
          <dl class="mt-4 grid grid-cols-[minmax(0,1fr)] gap-2.5">
            {details.map((row) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-border-subtle-default pb-2.5 last:border-b-0 last:pb-0">
                <dt class="text-single-sm-medium text-text-subtle-default">{row.label}</dt>
                <dd class="text-single-sm-medium text-text-primary-default text-right">
                  {row.href ? (
                    <a href={row.href} class="text-text-link-default hover:underline">{row.value}</a>
                  ) : row.datetime ? (
                    <time datetime={row.datetime} title={row.title} data-local-date-time={row.localDateTime ? true : undefined}>{row.value}</time>
                  ) : (
                    row.value
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      </aside>
    </div>
  </main>
</Base>

<style>
  .item-page-hero { position:relative; margin-top:.625rem; padding:.625rem 0 .875rem; overflow:hidden; }
  .item-page-hero.has-cover { display:flex; min-height:clamp(190px,24vw,270px); margin-inline:-1.5rem; padding:2rem 1.5rem 1.5rem; align-items:flex-end; border-radius:16px; isolation:isolate; }
  .item-page-cover,.item-page-cover-treatment { position:absolute; inset:0; width:100%; height:100%; }
  .item-page-cover { z-index:-1; overflow:hidden; background:color-mix(in srgb,var(--roadmap-product-accent) 18%,var(--color-surface-subtle-default)); }
  .item-page-cover .roadmap-cover-fill,.item-page-cover .roadmap-cover-reveal { filter:saturate(.82) contrast(.94); }
  .item-page-cover-treatment { background:linear-gradient(to top,var(--roadmap-glass-bg) 0%,color-mix(in srgb,var(--roadmap-glass-bg) 96%,transparent) 18%,color-mix(in srgb,var(--roadmap-glass-bg) 62%,transparent) 52%,color-mix(in srgb,var(--roadmap-glass-bg) 14%,transparent) 100%),color-mix(in srgb,var(--roadmap-product-accent) 14%,transparent); }
  :global(:root[data-theme='dark']) .item-page-cover .roadmap-cover-fill,:global(:root[data-theme='dark']) .item-page-cover .roadmap-cover-reveal { filter:brightness(.7) saturate(.68) contrast(.92); }
  :global(:root[data-theme='dark']) .item-page-cover-treatment { background:linear-gradient(to top,var(--roadmap-glass-bg) 0%,color-mix(in srgb,var(--roadmap-glass-bg) 97%,transparent) 20%,color-mix(in srgb,var(--roadmap-glass-bg) 68%,transparent) 54%,color-mix(in srgb,var(--roadmap-glass-bg) 20%,transparent) 100%),color-mix(in srgb,var(--roadmap-product-accent) 20%,transparent); }
  .item-page-hero.is-completed .item-page-cover .roadmap-cover-fill,.item-page-hero.is-completed .item-page-cover .roadmap-cover-reveal { filter:grayscale(.28) saturate(.65) contrast(.94); }
  :global(:root[data-theme='dark']) .item-page-hero.is-completed .item-page-cover .roadmap-cover-fill,:global(:root[data-theme='dark']) .item-page-hero.is-completed .item-page-cover .roadmap-cover-reveal { filter:brightness(.72) grayscale(.3) saturate(.52) contrast(.92); }
  .item-page-hero-copy { position:relative; display:grid; width:100%; grid-template-columns:40px minmax(0,1fr); gap:14px; align-items:start; }
  .item-page-hero.has-cover .item-page-hero-copy { width:fit-content; max-width:100%; padding:14px 16px; border:1px solid color-mix(in srgb,var(--color-border-subtle-default) 72%,transparent); border-radius:13px; background:color-mix(in srgb,var(--color-card) 92%,transparent); box-shadow:0 12px 32px rgb(10 14 20 / 18%),inset 0 1px 0 rgb(255 255 255 / 20%); -webkit-backdrop-filter:blur(12px) saturate(.86); backdrop-filter:blur(12px) saturate(.86); }
  :global(:root[data-theme='dark']) .item-page-hero.has-cover .item-page-hero-copy { border-color:rgb(255 255 255 / 14%); background:color-mix(in srgb,var(--color-card) 90%,transparent); box-shadow:0 14px 36px rgb(0 0 0 / 34%),inset 0 1px 0 rgb(255 255 255 / 7%); }
  .item-page-hero h1 { max-width:30ch; margin:0; font-size:clamp(1.8rem,3vw,2.5rem); line-height:1.06; }
  .item-page-status-summary { display:flex; flex-wrap:wrap; gap:10px clamp(24px,4vw,48px); margin:0; padding:14px 0 2px; border-top:1px solid var(--color-border-subtle-default); }
  .item-page-status-summary dt { color:var(--color-text-subtle-default); font-size:11px; font-weight:600; line-height:1.3; }
  .item-page-status-summary dd { display:flex; align-items:center; gap:7px; margin:4px 0 0; color:var(--color-text-primary-default); font-size:14px; font-weight:600; line-height:1.35; }
  .item-page-status-summary dd span { width:4px; height:16px; border-radius:999px; }
  @media (max-width:639px) {
    .item-page-hero.has-cover { min-height:165px; margin-inline:-1rem; padding:1.5rem 1rem 1.125rem; }
    .item-page-hero-copy { grid-template-columns:1fr; }
    .item-page-hero-copy :global(.product-mark) { display:none; }
    .item-page-hero h1 { font-size:clamp(1.7rem,8vw,2.1rem); }
    .item-page-status-summary { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
  @media (prefers-reduced-transparency:reduce) { .item-page-hero.has-cover .item-page-hero-copy { background:color-mix(in srgb,var(--color-card) 98%,transparent);-webkit-backdrop-filter:none;backdrop-filter:none; } }
  @media (prefers-contrast:more) { .item-page-hero.has-cover .item-page-hero-copy { border-color:var(--color-text-primary-default);background:var(--color-card);box-shadow:none; } }
</style>

<script>
  import { installItemImageViewer } from '../../lib/itemImageViewer';
  import '../../styles/image-viewer.css';
  let viewer: ReturnType<typeof installItemImageViewer> | undefined;
  document.addEventListener('astro:page-load', () => {
    viewer?.destroy();
    const root = document.querySelector<HTMLElement>('[data-item-page]');
    if (root) viewer = installItemImageViewer(root);
  });
  document.addEventListener('astro:before-swap', () => { viewer?.destroy(); viewer = undefined; });
</script>
