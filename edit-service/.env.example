# Server only. Replace placeholders using your own GitHub App and deployment.
# Keep this configuration, private keys and state outside the published site.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/to/private-key.pem
REPO=your-account/your-roadmap
ALLOWED_ORIGIN=http://localhost:4321
API_ORIGIN=http://localhost:8787
SESSION_SECRET=
LISTEN_ADDR=127.0.0.1:8787
ROADMAP_STATE_DIR=/absolute/path/to/private-state
REPO_CACHE_DIR=/absolute/path/to/private-repo-cache
